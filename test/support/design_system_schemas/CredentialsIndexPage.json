{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialRow"
      }
    },
    "oauthClients": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OauthClientRow"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialProjectRef"
      }
    },
    "credentialTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialTypeOption"
      }
    },
    "oauthSignIns": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OauthSignInResult"
      }
    },
    "canCreateGlobalOauthClient": {
      "type": "boolean"
    }
  },
  "required": [
    "credentials",
    "oauthClients",
    "projects",
    "credentialTypes",
    "oauthSignIns",
    "canCreateGlobalOauthClient"
  ],
  "additionalProperties": false,
  "definitions": {
    "CredentialRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "oauthClient": {
          "anyOf": [
            {
              "$ref": "#/definitions/CredentialOauthClient"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerEmail": {
          "type": "string"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CredentialProjectAccess"
          }
        },
        "externalId": {
          "type": ["string", "null"]
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transferStatus": {
          "$ref": "#/definitions/TransferStatus"
        },
        "scheduledDeletion": {
          "type": ["string", "null"]
        },
        "hasActivityInProjects": {
          "type": "boolean"
        },
        "canEdit": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "schema",
        "oauthClient",
        "ownerEmail",
        "projects",
        "externalId",
        "environments",
        "transferStatus",
        "scheduledDeletion",
        "hasActivityInProjects",
        "canEdit"
      ],
      "additionalProperties": false
    },
    "CredentialOauthClient": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mandatoryScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopesDocUrl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "mandatoryScopes",
        "optionalScopes",
        "scopesDocUrl"
      ],
      "additionalProperties": false
    },
    "CredentialProjectAccess": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "workflowsUsing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "name", "workflowsUsing"],
      "additionalProperties": false
    },
    "TransferStatus": {
      "type": ["string", "null"],
      "enum": ["pending", "completed", null]
    },
    "OauthClientRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ownerEmail": {
          "type": "string"
        },
        "global": {
          "type": "boolean"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CredentialProjectRef"
          }
        },
        "authorizationEndpoint": {
          "type": "string"
        },
        "tokenEndpoint": {
          "type": "string"
        },
        "revocationEndpoint": {
          "type": "string"
        },
        "introspectionEndpoint": {
          "type": "string"
        },
        "userinfoEndpoint": {
          "type": "string"
        },
        "mandatoryScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopesDocUrl": {
          "type": "string"
        },
        "canEdit": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "ownerEmail",
        "global",
        "projects",
        "authorizationEndpoint",
        "tokenEndpoint",
        "revocationEndpoint",
        "introspectionEndpoint",
        "userinfoEndpoint",
        "mandatoryScopes",
        "optionalScopes",
        "scopesDocUrl",
        "canEdit"
      ],
      "additionalProperties": false
    },
    "CredentialProjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "CredentialTypeOption": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["key", "name"],
      "additionalProperties": false
    },
    "OauthSignInResult": {
      "type": "object",
      "properties": {
        "signInId": {
          "type": "string"
        },
        "error": {
          "type": ["string", "null"]
        },
        "userInfo": {
          "anyOf": [
            {
              "$ref": "#/definitions/OauthUserInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["signInId", "error", "userInfo"],
      "additionalProperties": false
    },
    "OauthUserInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "email": {
          "type": ["string", "null"]
        }
      },
      "required": ["name", "email"],
      "additionalProperties": false
    }
  }
}
