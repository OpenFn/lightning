{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "variant": {
      "$ref": "#/definitions/SidebarVariant"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "user": {
      "$ref": "#/definitions/MenuUser"
    },
    "canAccessAdmin": {
      "type": "boolean"
    },
    "sysInfo": {
      "type": "boolean"
    },
    "adminEmail": {
      "type": "string"
    },
    "releaseLabel": {
      "type": "string"
    },
    "theme": {
      "$ref": "#/definitions/SidebarTheme"
    },
    "collapsed": {
      "type": "boolean"
    }
  },
  "required": [
    "variant",
    "user",
    "canAccessAdmin",
    "adminEmail",
    "releaseLabel",
    "collapsed"
  ],
  "additionalProperties": false,
  "definitions": {
    "SidebarVariant": {
      "type": "string",
      "enum": ["project", "profile", "admin"]
    },
    "MenuUser": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "experimentalFeatures": {
          "type": "boolean"
        }
      },
      "required": ["firstName", "lastName", "email", "experimentalFeatures"],
      "additionalProperties": false
    },
    "SidebarTheme": {
      "type": "string",
      "enum": ["primary-theme", "sudo-variant"]
    }
  }
}
