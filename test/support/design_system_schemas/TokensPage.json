{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ApiToken"
      }
    },
    "tokenId": {
      "type": ["string", "null"]
    }
  },
  "required": ["tokens", "tokenId"],
  "additionalProperties": false,
  "definitions": {
    "ApiToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "masked": {
          "type": "string"
        },
        "insertedAt": {
          "type": "string"
        },
        "lastUsedAt": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "masked", "insertedAt", "lastUsedAt"],
      "additionalProperties": false
    }
  }
}
