{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "project": {
      "$ref": "#/definitions/CurrentProject"
    },
    "projectLabel": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChannelRow"
      }
    },
    "totalChannels": {
      "type": "number"
    },
    "totalRequests": {
      "type": "number"
    },
    "logsHref": {
      "type": "string"
    },
    "canCreateChannel": {
      "type": "boolean"
    },
    "canEditChannel": {
      "type": "boolean"
    },
    "canDeleteChannel": {
      "type": "boolean"
    },
    "form": {
      "anyOf": [
        {
          "$ref": "#/definitions/ChannelForm"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project",
    "projectLabel",
    "channels",
    "totalChannels",
    "totalRequests",
    "logsHref",
    "canCreateChannel",
    "canEditChannel",
    "canDeleteChannel",
    "form"
  ],
  "additionalProperties": false,
  "definitions": {
    "CurrentProject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "parentId": {
          "type": ["string", "null"]
        },
        "color": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "parentId", "color"],
      "additionalProperties": false
    },
    "ChannelRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "destinationUrl": {
          "type": "string"
        },
        "proxyUrl": {
          "type": "string"
        },
        "requestCount": {
          "type": "number"
        },
        "lastActivityAt": {
          "type": ["string", "null"]
        },
        "logsHref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "destinationUrl",
        "proxyUrl",
        "requestCount",
        "lastActivityAt",
        "logsHref"
      ],
      "additionalProperties": false
    },
    "ChannelForm": {
      "type": "object",
      "properties": {
        "channel": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "proxyUrl": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "destinationUrl": {
                  "type": "string"
                },
                "destinationCredentialId": {
                  "type": "string"
                },
                "clientAuthMethodIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "clientAuthMethodIds",
                "destinationCredentialId",
                "destinationUrl",
                "enabled",
                "id",
                "name",
                "proxyUrl"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["id", "name"],
            "additionalProperties": false
          }
        },
        "authMethodOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["id", "name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["credentialOptions", "authMethodOptions"],
      "additionalProperties": false
    }
  }
}
