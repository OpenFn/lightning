#!/usr/bin/env node
// Turns a Figma variables export (W3C design tokens JSON) into Tailwind theme
// variables, written to assets/css/ui/tokens.css.
//
// - Colours: Text and Icon are merged into one name each, so "Text/Subtle"
//   and "Icon/Subtle" both become --color-subtle (text-subtle, fill-subtle).
// - Padding and Spacing share one scale: "padding-small" and "space-small"
//   both become --spacing-small (p-small, gap-small, m-small).
// - Size becomes --spacing-size-* (h-size-medium, w-size-medium).
// - Radius becomes --radius-* (rounded-md).
//
// Usage: bin/design-tokens path/to/export.json

import { readFileSync, writeFileSync } from 'node:fs';
import { basename } from 'node:path';

const OUT = new URL('../assets/css/ui/tokens.css', import.meta.url);

// Variables that redefine a Tailwind default, which restyles every existing use
// of it. radius-sm and spacing-none have different values from Tailwind's, and
// their classes (rounded-sm, leading-none, max-w-none) are in use.
const REDEFINES_DEFAULT = new Set([
  '--color-black',
  '--color-white',
  '--radius-sm',
  '--spacing-none',
]);

// Number groups: [Tailwind namespace, prefix Figma puts on every name]
const NUMBER_GROUPS = {
  Padding: ['spacing', 'padding-'],
  Spacing: ['spacing', 'space-'],
  Size: ['spacing', ''],
  Radius: ['radius', 'rounded-'],
};

// "Primary Link - Default" -> "primary-link", "Primary Link - Hover" -> "primary-link-hover"
const slug = name =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .replace(/(.)-default$/, '$1');

const colour = ({ hex, alpha = 1 }) =>
  alpha < 1
    ? hex + Math.round(alpha * 255).toString(16).padStart(2, '0')
    : hex;

const rem = px => (px === 0 ? '0' : `${px / 16}rem`);

const toVariable = (group, name, token) => {
  if (token.$type === 'color') {
    return [`--color-${slug(name)}`, colour(token.$value)];
  }

  const [namespace, prefix] = NUMBER_GROUPS[group] ?? [];
  if (!namespace || token.$type !== 'number') return null;
  if (!name.startsWith(prefix)) return null;

  return [`--${namespace}-${slug(name.slice(prefix.length))}`, rem(token.$value)];
};

const input = process.argv[2];
if (!input) {
  console.error('Usage: bin/design-tokens path/to/export.json');
  process.exit(1);
}

const tokens = JSON.parse(readFileSync(input, 'utf8'));
const variables = new Map();

for (const [group, entries] of Object.entries(tokens)) {
  if (group.startsWith('$')) continue;

  for (const [name, token] of Object.entries(entries)) {
    const variable = toVariable(group, name, token);

    if (!variable) {
      console.warn(`skipped ${group}/${name}: no rule for it`);
      continue;
    }

    const [key, value] = variable;

    if (REDEFINES_DEFAULT.has(key)) {
      console.warn(`skipped ${group}/${name}: ${key} redefines a Tailwind default`);
      continue;
    }
    if (variables.has(key) && variables.get(key) !== value) {
      console.error(
        `${group}/${name} is ${value}, but ${key} is already ${variables.get(key)}`
      );
      process.exit(1);
    }
    variables.set(key, value);
  }
}

const lines = [...variables].map(([key, value]) => `  ${key}: ${value};`);

writeFileSync(
  OUT,
  `/* Generated by bin/design-tokens from ${basename(input)}. Don't edit by hand. */\n` +
    `@theme {\n${lines.join('\n')}\n}\n`
);

console.log(`wrote ${variables.size} tokens to assets/css/ui/tokens.css`);
