#! /usr/bin/env bash
#
# Download a Node.js release tarball from nodejs.org, verify it against the
# signed SHASUMS256.txt, and extract it into /usr/local.
#
# Usage: install_node [--download-only] [--no-cleanup] <version>
#
#   --download-only  Download and verify, but don't install.
#   --no-cleanup     Keep the tarball and SHASUMS256 files.
#
# Needs curl, git, gpg (with dirmngr), sha256sum, tar and xz.
set -euo pipefail

# The signing keys come from a fixed commit of the official list, so git
# verifies their content against the commit hash. When a release is signed by
# a key this commit doesn't have, gpg fails with "No public key"; move this to
# a newer commit of https://github.com/nodejs/release-keys.
release_keys_commit=481637f813e912c4aa3622d7964ab426c97b8e8d

usage() {
  echo "Usage: install_node [--download-only] [--no-cleanup] <version>"
  exit 1
}

cleanup=true
download_only=false
node_version=""

for arg in "$@"; do
  case $arg in
  --no-cleanup) cleanup=false ;;
  --download-only) download_only=true ;;
  -*) usage ;;
  *)
    [[ -z $node_version ]] || usage
    node_version=$arg
    ;;
  esac
done

[[ -n $node_version ]] || usage

case $(uname -m) in
x86_64 | amd64) arch=x64 ;;
aarch64 | arm64) arch=arm64 ;;
*) echo "Unsupported CPU: $(uname -m)" && exit 1 ;;
esac

base_url=https://nodejs.org/dist/v${node_version}
tarball=node-v${node_version}-linux-${arch}.tar.xz
sumfiles=(SHASUMS256.txt SHASUMS256.txt.sig)

workdir=$(mktemp -d)

remove_downloads() {
  if [[ $cleanup == true ]]; then
    echo "- Cleaning up"
    rm -f "${sumfiles[@]}"
    if [[ $download_only == false ]]; then
      rm -f "$tarball"
    fi
  fi
}
trap 'remove_downloads; rm -rf "$workdir"' EXIT

echo "Fetching NodeJS ${node_version} (linux-${arch})..."

echo "- Getting validation files"
for file in "${sumfiles[@]}"; do
  curl -fsSLo "$file" "${base_url}/${file}"
done

if [[ -f $tarball ]]; then
  echo "- $tarball already exists, skipping download"
else
  echo "- Getting binary tarball"
  curl -fSLo "$tarball" "${base_url}/${tarball}"
fi

echo "- Getting release keys from nodejs/release-keys@${release_keys_commit:0:12}"
git init -q "$workdir/release-keys"
git -C "$workdir/release-keys" fetch -q --depth 1 \
  https://github.com/nodejs/release-keys.git "$release_keys_commit"
git -C "$workdir/release-keys" -c advice.detachedHead=false \
  checkout -q "$release_keys_commit"

export GNUPGHOME=$workdir/gnupg
mkdir -m 700 "$GNUPGHOME"
gpg --batch --quiet --import "$workdir"/release-keys/keys/*.asc

echo "- Verifying SHASUMS256.txt signature"
gpg --batch --verify SHASUMS256.txt.sig SHASUMS256.txt

echo "- Checking $tarball against SHASUMS256.txt"
grep " ${tarball}\$" SHASUMS256.txt | sha256sum -c -

if [[ $download_only == true ]]; then
  echo "🆗 NodeJS ${node_version} downloaded and verified."
  echo "   Install by running:"
  echo "   $ tar xJf $(pwd)/${tarball} --strip-components=1 -C /usr/local"
else
  echo "- Extracting to /usr/local"
  tar xJf "$tarball" --strip-components=1 -C /usr/local

  echo "- Checking for existence of binaries in PATH"
  which node npm

  installed=$(node -v)
  if [[ $installed != "v${node_version}" ]]; then
    echo "Expected node v${node_version}, got ${installed}"
    exit 1
  fi

  echo "🆗 NodeJS ${node_version} installed."
fi
