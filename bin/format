#! /usr/bin/env bash

set -e

cd "$(git rev-parse --show-toplevel)"

# The one definition of which files prettier owns. The pre-commit hook and CI
# both reach it through this script, so there is nowhere else to change it.
# Exclusions live in .prettierignore.
EXTS='\.(js|jsx|ts|tsx|md|css|json|yml|yaml|html)$'

show_help() {
  cat << EOF
Usage: bin/format [OPTIONS]

Format code across the Lightning project (Prettier, ESLint, and Elixir).

OPTIONS:
  (none)           Format everything: prettier, eslint --fix, mix format
  --check          Check formatting without writing. Exits non-zero on drift.
                   This is what CI runs.
  --staged         Format staged files only and re-stage them.
                   This is what the pre-commit hook runs.
  --changed, -c    Format files changed on this branch vs main
  --help, -h       Show this help message
EOF
  exit 0
}

PRETTIER=(npm --prefix assets exec prettier --
  --config .prettierrc --ignore-path .prettierignore)

# Modes are just different file lists, so each one is a single command.
all_files() { git ls-files | grep -E "$EXTS" || true; }
staged_files() {
  git diff --cached --name-only --diff-filter=ACM | grep -E "$EXTS" || true
}
changed_files() {
  git diff --name-only --diff-filter=ACMR main...HEAD | grep -E "$EXTS" || true
}

MODE=all
case "${1:-}" in
  --check) MODE=check ;;
  --staged) MODE=staged ;;
  --changed | -c) MODE=changed ;;
  --help | -h) show_help ;;
  '') ;;
  *)
    echo "Unknown option: $1"
    echo "Use --help for usage information"
    exit 1
    ;;
esac

case "$MODE" in
  check)
    # No eslint or mix format here: mix format is already checked by its own CI
    # step, and eslint is not yet clean enough to gate on.
    all_files | xargs "${PRETTIER[@]}" --check
    ;;

  staged)
    FILES=$(staged_files)
    if [ -n "$FILES" ]; then
      echo "$FILES" | xargs "${PRETTIER[@]}" --write > /dev/null
      echo "$FILES" | xargs git add
    fi

    EX=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs|heex)$' || true)
    if [ -n "$EX" ]; then
      echo "$EX" | xargs mix format
      echo "$EX" | xargs git add
    fi
    ;;

  *)
    [ "$MODE" = changed ] && FILES=$(changed_files) || FILES=$(all_files)

    if [ -n "$FILES" ]; then
      echo "Running Prettier..."
      echo "$FILES" | xargs "${PRETTIER[@]}" --write | grep -v '(unchanged)$' || true
    fi

    echo "Running ESLint..."
    JS=$(echo "$FILES" | grep -E '^assets/.*\.(js|jsx|ts|tsx)$' | sed 's|^assets/||' || true)
    if [ -n "$JS" ]; then
      # ESLint is not clean yet, so warnings and lint errors must not stop the
      # run. Only a crash (exit 2) is fatal.
      echo "$JS" | xargs npm --prefix assets run lint -- --fix --exit-on-fatal-error || {
        [ $? -le 1 ] || exit $?
      }
    fi

    echo "Running mix format..."
    if [ "$MODE" = changed ]; then
      EX=$(git diff --name-only --diff-filter=ACMR main...HEAD | grep -E '\.(ex|exs|heex)$' || true)
      [ -z "$EX" ] || echo "$EX" | xargs mix format
    else
      mix format
    fi
    echo "✓ Done"
    ;;
esac
