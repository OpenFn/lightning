#!/usr/bin/env bash

# Usage: port_wrapper [--stderr FILE] [--remove PATH]... -- program [args...]
#
#   --stderr FILE  write the program's stderr to FILE
#   --remove PATH  delete PATH if the owner goes away (stdin closes) or the
#                  wrapper is sent SIGTERM; on a normal exit the owner is still
#                  there and cleans up itself

stderr=
remove=()
while [ "$1" != "--" ]; do
  case "$1" in
    --stderr) stderr=$2; shift 2 ;;
    --remove) remove+=("$2"); shift 2 ;;
    *) echo "port_wrapper: unexpected argument '$1'" >&2; exit 64 ;;
  esac
done
shift

cleanup() {
  [ ${#remove[@]} -gt 0 ] && rm -rf -- "${remove[@]}"
}

pid1=
terminated=

# On SIGTERM pass it on to the program; the main flow waits for it to stop
# and then cleans up. A SIGTERM that lands before the program's pid is known
# takes down the whole group, program included.
handle_sigterm() {
  if [ -z "$pid1" ]; then
    cleanup
    kill -KILL -- -$$
  fi
  terminated=1
  kill -TERM $pid1
}
trap 'handle_sigterm' SIGTERM

# Start the program in the background
if [ -n "$stderr" ]; then
  exec "$@" 2>"$stderr" &
else
  exec "$@" &
fi
pid1=$!

# Silence warnings from here on
exec >/dev/null 2>&1

# Read from stdin in the background and force kill the program when stdin
# closes. Erlang starts each port in its own process group, so killing the
# group also takes down anything the program spawned (the CLI forks a runner).
# The explicit `<&0` stops bash pointing a background job's stdin at
# /dev/null, and the reader is a plain subshell so `$!` is the process that
# must be killed once the program exits.
(
  while read; do :; done
  cleanup
  kill -KILL -- -$$ || kill -KILL $pid1
) <&0 &
pid2=$!

wait $pid1
ret=$?

# A trapped SIGTERM interrupts `wait` before the program has exited; wait
# again for its real status. 127 means the first wait already reaped it.
if [ -n "$terminated" ]; then
  wait $pid1
  status=$?
  [ $status -eq 127 ] || ret=$status
fi

kill -KILL $pid2
[ -n "$terminated" ] && cleanup
exit $ret
