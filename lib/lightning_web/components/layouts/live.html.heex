<main class="h-screen">
  <div class="flex flex-row h-full">
    <%= if LayoutComponents.hosted_sidebar?(assigns) do %>
      <LayoutComponents.heex_sidebar
        variant={if assigns[:project], do: "project", else: "profile"}
        project={assigns[:project]}
        current_user={assigns[:current_user]}
        active_menu_item={assigns[:active_menu_item]}
        side_menu_theme={@side_menu_theme}
        sidebar_collapsed={assigns[:sidebar_collapsed] == true}
        is_first_setup={assigns[:is_first_setup] == true}
      />
    <% else %>
      <LayoutComponents.sidebar_bridge
        variant={if assigns[:project], do: "project", else: "profile"}
        project={assigns[:project]}
        current_user={@current_user}
        side_menu_theme={@side_menu_theme}
        sidebar_collapsed={assigns[:sidebar_collapsed] == true}
      />
    <% end %>
    <div class="flex-auto">
      <LayoutComponents.flash_bridge flash={@flash} />
      <.live_nav_block flash={@flash}>
        {@inner_content}
      </.live_nav_block>
      <.live_component
        module={LightningWeb.LiveComponentPortal}
        id="component-portal"
      />
      <.live_component
        :if={assigns[:gdpr_banner]}
        module={@gdpr_banner.component}
        id={@gdpr_banner.id}
        current_user={@current_user}
      />
    </div>
  </div>
  <%= if !assigns[:is_first_setup] do %>
    {(assigns[:global_picker] || (&LayoutComponents.global_project_picker/1)).(
      assigns
    )}
  <% end %>
</main>
