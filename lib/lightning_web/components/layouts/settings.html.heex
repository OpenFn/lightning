<main class="h-screen">
  <div class="flex flex-row h-full">
    <%= if LayoutComponents.hosted_sidebar?(assigns) do %>
      <LayoutComponents.heex_sidebar
        variant="admin"
        current_user={@current_user}
        active_menu_item={@active_menu_item}
        side_menu_theme={@side_menu_theme}
        sidebar_collapsed={assigns[:sidebar_collapsed] == true}
      />
    <% else %>
      <LayoutComponents.sidebar_bridge
        variant="admin"
        current_user={@current_user}
        side_menu_theme={@side_menu_theme}
        sidebar_collapsed={assigns[:sidebar_collapsed] == true}
      />
    <% end %>
    <div class="flex-auto">
      <LayoutComponents.flash_bridge flash={@flash} />
      {@inner_content}
    </div>
  </div>
  {(assigns[:global_picker] || (&LayoutComponents.global_project_picker/1)).(
    assigns
  )}
</main>
