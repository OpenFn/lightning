<div id={@id}>
  <div :if={@action == :new} class="bg-white p-4 rounded-md">
    <.form
      :let={f}
      id="project-repo-connection-form"
      for={@changeset}
      as={:connection}
      phx-change="validate"
      phx-submit="save"
      phx-target={@myself}
    >
      <h6 class="mb-4 font-medium text-black">
        Configure Two-Way Sync to GitHub
      </h6>
      <div class="mb-4 flex items-start gap-3 rounded-md border border-blue-200 bg-blue-50 p-3 text-sm text-black">
        <.icon
          name="hero-information-circle"
          class="h-5 w-5 shrink-0 text-blue-500"
        />
        <p>
          Learn more about synchronizing your project with GitHub at
          <.link
            target="_blank"
            href="https://docs.openfn.org/documentation/link-to-GitHub"
            class="font-medium underline"
          >
            docs.openfn.org
          </.link>
        </p>
      </div>
      <%!-- Token is expired/invalid --%>
      <.error_banner
        :if={show_invalid_oauth_error?(@installations)}
        title="Unable to load GitHub installations"
      >
        <p>
          Your GitHub authentication has expired or is invalid.
        </p>
        <p class="mt-2">
          Go to
          <.link
            href={~p"/profile"}
            class="font-medium text-yellow-800 hover:text-yellow-900 underline"
          >
            Settings
          </.link>
          and reconnect your GitHub account.
        </p>
      </.error_banner>
      <%!-- Token valid but no installations (app uninstalled/never installed) --%>
      <.error_banner
        :if={show_no_installations_warning?(@installations)}
        title="No GitHub installations found"
      >
        <p>
          You haven't installed the OpenFn GitHub App yet, or you may have uninstalled it.
        </p>
        <p class="mt-2">
          <.link
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-yellow-800 hover:text-yellow-900 underline"
            href={"https://github.com/apps/#{github_config()[:app_name]}"}
          >
            Install or manage GitHub app installations
          </.link>
        </p>
      </.error_banner>
      <%!-- GitHub API error (GitHub down or other issues) --%>
      <.error_banner
        :if={show_api_error?(@installations)}
        title="Unable to load GitHub installations"
      >
        <p>
          There was a problem connecting to GitHub. Refresh the page or contact support if the problem persists.
        </p>
      </.error_banner>
      <div class="@container">
        <div class="grid grid-cols-1 gap-4 @[456px]:grid-cols-2 @[692px]:grid-cols-3">
          <div>
            <.input
              id="select-installations-input"
              type="custom-select"
              field={f[:github_installation_id]}
              label="GitHub Installation"
              prompt="Select an installation"
              options={installations_select_options(@installations)}
              disabled={
                @actions_disabled ||
                  if(!@installations.ok?, do: true, else: false)
              }
              required="true"
              button_placement="right"
            >
              <.button
                id="refresh-installation-button"
                type="button"
                theme="custom"
                class="rounded-l-none my-px h-9 text-gray-900 ring-1 ring-gray-300 hover:bg-gray-100"
                disabled={
                  @actions_disabled ||
                    if(@installations.loading, do: true, else: false)
                }
                phx-click="refresh-installations"
                phx-target={@myself}
              >
                <.icon
                  name="hero-arrow-path-mini"
                  class={"-ml-0.5 h-5 w-5 #{if(@installations.loading, do: "animate-spin")}"}
                />
              </.button>
            </.input>
          </div>
          <div>
            <.input
              id="select-repos-input"
              searchable
              type="custom-select"
              field={f[:repo]}
              label="Repository"
              prompt="Select a repository"
              options={
                repos_select_options(@repos, f[:github_installation_id].value)
              }
              disabled={
                to_string(f[:github_installation_id].value) == "" or !@repos.ok?
              }
              required="true"
            />
          </div>
          <div class="col-span-full text-xs text-gray-600 @[692px]:order-last">
            Can't find the right installation or repository?
            <.link
              target="_blank"
              class="link"
              href={"https://github.com/apps/#{github_config()[:app_name]}"}
            >
              Create/update GitHub installations or modify permissions.
            </.link>
          </div>
          <div>
            <.input
              id="select-branches-input"
              searchable
              type="custom-select"
              field={f[:branch]}
              label="Branch"
              prompt="Select a branch"
              options={branches_select_options(@branches, f[:repo].value)}
              disabled={to_string(f[:repo].value) == "" or !@branches.ok?}
              required="true"
              button_placement="right"
            >
              <.button
                id="refresh-branches-button"
                type="button"
                theme="custom"
                class="rounded-l-none my-px h-9 text-gray-900 ring-1 ring-gray-300 hover:bg-gray-100"
                disabled={if(@branches.loading, do: true, else: false)}
                phx-click="refresh-branches"
                phx-target={@myself}
              >
                <.icon
                  name="hero-arrow-path-mini"
                  class={"-ml-0.5 h-5 w-5 #{if(@installations.loading, do: "animate-spin")}"}
                />
              </.button>
            </.input>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <.sync_order_radio form={f} />
      </div>
      <div :if={f[:sync_direction].value == :deploy} class="mt-4">
        <.input
          type="text"
          field={f[:config_path]}
          label="Path to config (required)"
          placeholder={"./openfn-#{@project.id}-config.json"}
          class="placeholder:italic placeholder:text-slate-400"
        />
      </div>
      <%= if f[:branch].value do %>
        <.accept_checkbox
          project={@project}
          form={f}
          default_branch={
            get_default_branch(
              @repos,
              f[:repo].value
            )
          }
        />
      <% end %>
      <div class="flex gap-4 mt-2">
        <.button
          id="connect-and-sync-button"
          type="submit"
          theme="primary"
          phx-disable-with="Connecting..."
          disabled={@actions_disabled || !@changeset.valid?}
          tooltip={@actions_disabled && @actions_disabled_tooltip}
        >
          Connect Branch & Initiate First Sync
        </.button>
      </div>
      <.config_format_toggle
        :if={f[:sync_direction].value != :deploy}
        form={f}
        project_id={@project.id}
        myself={@myself}
      />
    </.form>
  </div>
  <div :if={@action == :show}>
    <div class="bg-white p-4 rounded-md">
      <h6 class="mb-4 font-medium text-black">Connected to GitHub</h6>
      <.verify_connection_banner
        id="verify-connection-banner"
        verify_connection={@verify_connection}
        myself={@myself}
        changeset={@changeset}
        repos={@repos}
        project={@project}
        can_reconnect={
          @can_install_github &&
            can_access_github_installation?(
              @project_repo_connection,
              @installations
            )
        }
      />
      <div class="flex flex-col gap-2 text-black">
        <span>
          Repository:
          <.link
            href={"https://www.github.com/" <> @project_repo_connection.repo}
            target="_blank"
            class="link"
          >
            {@project_repo_connection.repo}
          </.link>
        </span>

        <span>
          Branch:
          <span class="text-xs font-mono bg-gray-200 rounded-md p-1">
            {@project_repo_connection.branch}
          </span>
        </span>

        <span>
          GitHub Installation ID:
          <span class="text-xs font-mono bg-gray-200 rounded-md p-1">
            {@project_repo_connection.github_installation_id}
          </span>
        </span>

        <span :if={!@project_repo_connection.sync_version}>
          Path to config:
          <span class="text-xs font-mono bg-gray-200 rounded-md p-1">
            {ProjectRepoConnection.config_path(@project_repo_connection)}
          </span>
        </span>

        <p
          :if={!@project_repo_connection.sync_version}
          class="text-xs text-gray-600"
        >
          This connection uses the legacy sync format (config.json). Reconnect to update to v2 sync formats
        </p>

        <div class="flex gap-4 pt-2">
          <.button
            id="initiate-sync-button"
            disabled={
              @actions_disabled || !@can_initiate_github_sync ||
                !@verify_connection.ok?
            }
            type="button"
            theme="primary"
            tooltip={
              (@actions_disabled && @actions_disabled_tooltip) ||
                (!@can_initiate_github_sync &&
                   "Contact an editor or admin to sync.")
            }
            phx-click="initiate-sync"
            phx-disable-with="Syncing.."
            phx-target={@myself}
          >
            Initiate Sync to Branch
          </.button>
          <.button
            :if={@can_install_github}
            id="remove-integration-button"
            type="button"
            theme="danger"
            phx-click={show_modal("remove_connection_modal")}
          >
            Remove integration
          </.button>
        </div>
      </div>
      <.confirm_connection_removal_modal
        :if={@can_install_github}
        id="remove_connection_modal"
        myself={@myself}
      />
    </div>
  </div>
</div>
