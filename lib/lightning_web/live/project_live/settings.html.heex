<.design_system_page
  name="ProjectSettingsPage"
  props={props(assigns)}
  banner={assigns[:banner]}
  current_user={@current_user}
/>
<%!-- Parts an instance can configure, drawn under the Setup tab as before. --%>
<div
  :if={@hosted_concurrency_input || @usage_caps_input_component}
  id="project-settings-hosted"
  phx-hook="HashPanel"
  data-hash="project"
  data-default-hash="project"
  class="mx-auto max-w-7xl space-y-4 px-4 pb-8 sm:px-6 lg:px-8"
>
  <div :if={@hosted_concurrency_input} class="bg-white p-4 rounded-md space-y-4">
    <h6 class="font-medium text-black">Concurrency Override</h6>
    <.form
      :let={f}
      for={@project_changeset}
      id="hosted-concurrency-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-4"
    >
      <.concurrency_input_slot
        component={@hosted_concurrency_input}
        field={f[:concurrency]}
        project={@project}
        disabled={not @can_edit_project}
      />
      <.button
        id="hosted-concurrency-submit-btn"
        type="submit"
        theme="primary"
        disabled={!(Enum.any?(@project_changeset.changes) and @can_edit_project)}
      >
        Save
      </.button>
    </.form>
  </div>
  <.usage_caps_input_slot
    :if={@usage_caps_input_component}
    component={@usage_caps_input_component}
    project={@project}
    current_user={@current_user}
  />
</div>
<%!-- An instance's MFA limit banner, under the Security tab as before. --%>
<div
  :if={assigns[:mfa_banner]}
  id="project-settings-mfa-banner"
  phx-hook="HashPanel"
  data-hash="security"
  data-default-hash="project"
  class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8"
>
  {Phoenix.LiveView.TagEngine.component(
    @mfa_banner.function,
    @mfa_banner.attrs,
    {__ENV__.module, __ENV__.function, __ENV__.file, __ENV__.line}
  )}
</div>
<%!-- An instance's retention limit, when it is a component, under Data Storage. --%>
<div
  :if={
    match?(
      %{function: func} when is_function(func),
      @data_retention_limit_message
    )
  }
  id="project-settings-data-retention-limit"
  phx-hook="HashPanel"
  data-hash="data-storage"
  data-default-hash="project"
  class="mx-auto max-w-7xl px-4 pb-8 text-xs sm:px-6 lg:px-8"
>
  {Phoenix.LiveView.TagEngine.component(
    @data_retention_limit_message.function,
    @data_retention_limit_message.attrs,
    {__ENV__.module, __ENV__.function, __ENV__.file, __ENV__.line}
  )}
</div>
<%!--
  Under the Sync to GitHub tab: an instance's GitHub limit banner, and the
  form that connects a repository, which the page doesn't draw.
--%>
<div
  :if={assigns[:github_banner] || connect_github_form?(assigns)}
  id="project-settings-vcs-hosted"
  phx-hook="HashPanel"
  data-hash="vcs"
  data-default-hash="project"
  class="mx-auto max-w-7xl space-y-4 px-4 pb-8 sm:px-6 lg:px-8"
>
  <div :if={assigns[:github_banner]}>
    {Phoenix.LiveView.TagEngine.component(
      @github_banner.function,
      @github_banner.attrs,
      {__ENV__.module, __ENV__.function, __ENV__.file, __ENV__.line}
    )}
  </div>
  <.live_component
    :if={connect_github_form?(assigns)}
    id="github-sync-component"
    module={LightningWeb.ProjectLive.GithubSyncComponent}
    user={@current_user}
    project_repo_connection={
      %Lightning.VersionControl.ProjectRepoConnection{project_id: @project.id}
    }
    project={@project}
    action={:new}
    can_install_github={@can_install_github}
    can_initiate_github_sync={@can_initiate_github_sync}
    actions_disabled={is_map(assigns[:github_banner])}
    actions_disabled_tooltip={
      is_map(assigns[:github_banner]) && Map.get(assigns[:github_banner], :text)
    }
  />
</div>
