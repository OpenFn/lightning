<div class="flex h-full w-full flex-col">
  <Common.dynamic_component
    :if={assigns[:banner]}
    function={@banner.function}
    args={@banner.attrs}
  />
  <div
    id="tokens-page"
    class="flex-auto"
    phx-hook="ReactComponent"
    phx-update="ignore"
    data-react-name="TokensPage"
    data-react-file={~p"/assets/js/design-system/TokensPage.js"}
    data-tokens={tokens_json(@tokens)}
  >
  </div>
</div>
