<.design_system_page
  name="ProfilePage"
  props={
    %{
      user: user_json(@current_user),
      mfa: %{
        enabled: @current_user.mfa_enabled,
        backupCodesHref: ~p"/profile/auth/backup_codes"
      },
      github: %{connectHref: @github_connect_href, status: @github_status},
      experimentalFeatures:
        Map.get(@current_user.preferences, "experimental_features", false),
      deletion: @deletion,
      deleting: @deleting and is_nil(@hosted_delete_modal)
    }
  }
  banner={assigns[:banner]}
  current_user={@current_user}
/>
<%!-- Parts an instance can configure, drawn beside the page as before. --%>
<.live_component
  :if={@deleting and @hosted_delete_modal}
  module={@hosted_delete_modal}
  id={@current_user.id}
  user={@current_user}
  logout={true}
  return_to={~p"/profile"}
/>
<div :if={@gdpr_preferences} class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
  <.live_component
    module={@gdpr_preferences.component}
    id={@gdpr_preferences.id}
    current_user={@current_user}
  />
</div>
