<LayoutComponents.page_content>
  <:header>
    <LayoutComponents.header current_user={@current_user}>
      <:title>Maintenance</:title>
    </LayoutComponents.header>
  </:header>
  <LayoutComponents.centered>
    <div class="flex flex-col gap-4">
      <div
        id="update-card"
        class="bg-white shadow-xs rounded-lg border border-gray-200 p-6 flex flex-col gap-4"
      >
        <div class="flex items-start justify-between gap-6">
          <div class="flex flex-col">
            <h2 class="text-lg font-semibold text-secondary-900">
              Version
            </h2>
            <p class="mt-1 text-sm text-secondary-600">
              Checks the image repository for new full releases. Set which
              repository with the <.inline_code value="UPDATE_CHECK_*" />
              environment variables.
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <.update_status_pill status={@update_status} />
            <.button
              theme="secondary"
              phx-click="check_for_update"
              id="check-for-update-button"
              disabled={@checking_update? or not @update_check.enabled}
            >
              {if @checking_update?, do: "Checking...", else: "Check now"}
            </.button>
          </div>
        </div>

        <Common.alert
          :if={@update_status && @update_status.update_available?}
          id="update-available-callout"
          type="warning"
          header={"v#{@update_status.latest} is available. Please upgrade."}
        >
          <:message>
            <p>
              This instance is running v{@update_status.current}. See the
              <a
                id="update-instructions-link"
                href={@update_status.instructions_url}
                target="_blank"
                class="underline font-medium"
              >
                upgrade guidelines
              </a>
              for how to upgrade.
            </p>
          </:message>
        </Common.alert>

        <p
          :if={!@update_check.enabled}
          id="update-check-disabled"
          class="text-sm text-secondary-600"
        >
          The update check is turned off. Set
          <.inline_code value="UPDATE_CHECK_ENABLED=true" /> and restart
          to turn it on.
        </p>

        <div class="flex flex-col gap-1.5 text-sm text-secondary-700">
          <p>
            <span class="font-medium text-secondary-900">Running:</span>
            <.inline_code
              id="update-current-version"
              value={"v#{Lightning.UpdateCheck.current_version()}"}
            />
          </p>
          <p :if={@update_status && @update_status.latest}>
            <span class="font-medium text-secondary-900">Latest release:</span>
            <.inline_code
              id="update-latest-version"
              value={"v#{@update_status.latest}"}
            />
          </p>
          <p>
            <span class="font-medium text-secondary-900">Checking:</span>
            <.inline_code
              id="update-source"
              value={"#{@update_check.registry}/#{@update_check.repository}:#{@update_check.tag}"}
            />
          </p>
          <p :if={@update_status} class="text-xs text-secondary-500">
            Last checked {Calendar.strftime(
              @update_status.checked_at,
              "%Y-%m-%d %H:%M UTC"
            )}.
          </p>
        </div>
      </div>

      <div
        id="workers-card"
        class="bg-white shadow-xs rounded-lg border border-gray-200 p-6 flex flex-col gap-4"
      >
        <div class="flex items-start justify-between gap-6">
          <div class="flex flex-col">
            <h2 class="text-lg font-semibold text-secondary-900">
              Workers
            </h2>
            <p class="mt-1 text-sm text-secondary-600">
              Workers connected to this instance right now, across every node,
              and the versions they report. Updates as workers connect and
              disconnect.
            </p>
          </div>
          <div class="shrink-0">
            <.workers_status_pill
              status={@update_status}
              count={@worker_count}
              outdated={@outdated_worker_count}
            />
          </div>
        </div>

        <Common.alert
          :if={@outdated_worker_count > 0}
          id="worker-update-callout"
          type="warning"
          header={"ws-worker v#{@update_status.worker.latest} is available. Please upgrade."}
        >
          <:message>
            <p>
              {@outdated_worker_count} of {@worker_count} connected workers
              run an older version. See the
              <a
                id="worker-update-instructions-link"
                href={@update_status.instructions_url}
                target="_blank"
                class="underline font-medium"
              >
                upgrade guidelines
              </a>
              for how to upgrade.
            </p>
          </:message>
        </Common.alert>

        <p
          :if={@worker_count == 0}
          id="no-workers"
          class="text-sm text-secondary-600"
        >
          No workers are connected, so no runs will be processed.
        </p>

        <.table :if={@worker_count > 0} id="worker-versions">
          <:header>
            <.tr>
              <.th>Version</.th>
              <.th>API version</.th>
              <.th>Workers</.th>
              <.th>Capacity</.th>
            </.tr>
          </:header>
          <:body>
            <.tr
              :for={{group, index} <- Enum.with_index(@worker_groups)}
              id={"worker-group-#{index}"}
            >
              <.td>
                <span class="flex items-center gap-2">
                  <.inline_code value={
                    if group.version, do: "v#{group.version}", else: "unknown"
                  } />
                  <.pill :if={group.outdated?} color="yellow">Outdated</.pill>
                </span>
              </.td>
              <.td>{group.api_version || "unknown"}</.td>
              <.td>{group.count}</.td>
              <.td>{group.capacity}</.td>
            </.tr>
          </:body>
        </.table>

        <div class="flex flex-col gap-1.5 text-sm text-secondary-700">
          <p :if={@worker_count > 0}>
            <span class="font-medium text-secondary-900">Total capacity:</span>
            <span id="worker-capacity">
              {@worker_capacity} concurrent {if @worker_capacity == 1,
                do: "run",
                else: "runs"}
            </span>
          </p>
          <p :if={@update_status && @update_status.worker}>
            <span class="font-medium text-secondary-900">Latest release:</span>
            <.inline_code
              id="worker-latest-version"
              value={"v#{@update_status.worker.latest}"}
            />
          </p>
          <p :if={@update_check.worker_repository}>
            <span class="font-medium text-secondary-900">Checking:</span>
            <.inline_code
              id="worker-update-source"
              value={"#{@update_check.worker_registry}/#{@update_check.worker_repository}:latest"}
            />
          </p>
        </div>
      </div>

      <div
        id="refresh-adaptors-card"
        class="bg-white shadow-xs rounded-lg border border-gray-200 p-6 flex items-start justify-between gap-6"
      >
        <div class="flex flex-col">
          <h2 class="text-lg font-semibold text-secondary-900">
            Refresh Adaptor Registry
          </h2>
          <p class="mt-1 text-sm text-secondary-600">
            Re-fetch the list of available adaptors and their versions.
          </p>
        </div>
        <.button
          theme="primary"
          phx-click="refresh_adaptors"
          id="refresh-adaptors-button"
        >
          Run
        </.button>
      </div>

      <div
        id="refresh-icons-card"
        class="bg-white shadow-xs rounded-lg border border-gray-200 p-6 flex items-start justify-between gap-6"
      >
        <div class="flex flex-col">
          <h2 class="text-lg font-semibold text-secondary-900">
            Refresh Adaptor Icons
          </h2>
          <p class="mt-1 text-sm text-secondary-600">
            Re-fetch icons for every adaptor and replace rows whose icon has
            changed. Does not touch adaptor metadata or version history.
          </p>
        </div>
        <.button
          theme="primary"
          phx-click="refresh_icons"
          id="refresh-icons-button"
        >
          Run
        </.button>
      </div>

      <div
        id="usage-metrics-card"
        class="bg-white shadow-xs rounded-lg border border-gray-200 p-6 flex flex-col gap-4"
      >
        <div class="flex items-start justify-between gap-6">
          <div class="flex flex-col">
            <h2 class="text-lg font-semibold text-secondary-900">
              Anonymous Usage Metrics
            </h2>
            <p id="usage-metrics-links" class="mt-1 text-sm text-secondary-600">
              How this instance reports anonymous, aggregate usage metrics to
              OpenFn. Configured with environment variables; share the details
              below with the team maintaining your instance. See
              <a
                href="https://docs.openfn.org/documentation/contribute/impact#the-data-yes-all-of-it"
                target="_blank"
                class="link"
              >
                exactly what data is sent
              </a>
              and how it's used on the <a
                href="https://www.openfn.org/impact"
                target="_blank"
                class="link"
              >
                public impact page</a>. Questions? Email <a
                href="mailto:admin@openfn.org"
                class="link"
              >admin@openfn.org</a>.
            </p>
          </div>
          <div class="shrink-0">
            <.async_result :let={status} assign={@usage_tracking}>
              <.usage_status_pill enabled={status.enabled} />
            </.async_result>
          </div>
        </div>

        <.async_result :let={status} assign={@usage_tracking}>
          <:loading>
            <p class="flex items-center gap-1 text-sm text-secondary-500">
              <.icon name="hero-arrow-path" class="h-4 w-4 animate-spin" />
              Loading usage metrics status...
            </p>
          </:loading>
          <:failed>
            <p class="text-sm text-secondary-500">
              Could not load the usage metrics status.
            </p>
          </:failed>

          <Common.alert
            :if={!status.enabled}
            id="usage-metrics-disabled-callout"
            type="danger"
            header="Please consider turning anonymous usage metrics back on."
          >
            <:message>
              <p>
                OpenFn is a free and open-source Digital Public Good. These
                anonymous, aggregate reports are how we show our impact,
                understand what our users need, and secure the donor funding
                that keeps the project alive. Without them, your deployment is
                invisible to the community who builds and maintains OpenFn.
              </p>
              <p class="mt-2">
                Set
                <.inline_code tone="red" value="USAGE_TRACKING_ENABLED=true" />
                and restart Lightning. See
                <a
                  href="https://www.openfn.org/impact"
                  target="_blank"
                  class="underline font-medium"
                >
                  https://www.openfn.org/impact
                </a>
                to see how your fellow operators report.
              </p>
            </:message>
          </Common.alert>

          <div class="flex flex-col gap-1.5 text-sm text-secondary-700">
            <p>
              <span class="font-medium text-secondary-900">
                {if status.enabled, do: "Reporting to:", else: "Would report to:"}
              </span>
              <.inline_code id="usage-metrics-host" value={status.host} />
            </p>
            <p :if={status.identity} class="flex items-center gap-1.5">
              <span class="font-medium text-secondary-900">Instance UUID:</span>
              <.inline_code
                id="usage-metrics-instance-id"
                class="break-all"
                value={status.identity.instance_id}
              />
              <Common.copy_icon_button
                id="copy-usage-metrics-instance-id"
                value={status.identity.instance_id}
                title="Copy instance UUID"
                size={3}
              />
            </p>
            <p :if={status.identity} class="flex items-center gap-1.5">
              <span class="font-medium text-secondary-900">Hashed UUID:</span>
              <.inline_code
                id="usage-metrics-hashed-id"
                class="break-all"
                value={status.identity.hashed_id}
              />
              <Common.copy_icon_button
                id="copy-usage-metrics-hashed-id"
                value={status.identity.hashed_id}
                title="Copy hashed UUID"
                size={3}
              />
            </p>
            <p :if={!status.identity} id="usage-metrics-no-instance-id">
              <span class="font-medium text-secondary-900">Instance UUID:</span>
              {if status.enabled,
                do: "generated the first time metrics are collected.",
                else: "generated once metrics are enabled."}
            </p>
          </div>

          <p id="usage-metrics-identity-mode" class="text-xs text-secondary-500">
            <span :if={status.enabled && status.cleartext}>
              The instance UUID is sent in cleartext along with its SHA-256 hash.
            </span>
            <span :if={status.enabled && !status.cleartext}>
              Only the hashed UUID (SHA-256) is sent. Set
              <.inline_code value="USAGE_TRACKING_UUIDS=cleartext" />
              to send the UUID itself.
            </span>
            <span :if={!status.enabled}>
              Nothing is sent while usage metrics are disabled.
            </span>
          </p>
        </.async_result>
      </div>
    </div>
  </LayoutComponents.centered>
</LayoutComponents.page_content>
