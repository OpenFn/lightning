<.design_system_page
  name="AdminAuditPage"
  props={
    %{
      events: events_json(@page.entries),
      page: %{
        number: @page.page_number,
        size: @page.page_size,
        totalEntries: @page.total_entries
      }
    }
  }
  banner={assigns[:banner]}
  current_user={@current_user}
/>
