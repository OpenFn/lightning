<.design_system_page
  :if={@live_action == :channel_logs}
  name="HistoryChannelLogsPage"
  props={
    %{
      project: %{
        id: @project.id,
        parentId: @project.parent_id,
        color: @project.color
      },
      projectLabel: @project_label,
      channelsEnabled: @channels_enabled,
      workOrdersHref: ~p"/projects/#{@project}/history",
      channelLogsHref: ~p"/projects/#{@project}/history/channels",
      channels: Enum.map(@channels, &%{id: &1.id, name: &1.name}),
      channelId: @channel_logs.channel_id,
      rows: channel_log_rows(@channel_logs.page),
      page: page_json(@channel_logs.page)
    }
  }
  banner={assigns[:banner]}
  current_user={@current_user}
/>
<.design_system_page
  :if={@live_action == :index}
  name="HistoryWorkOrdersPage"
  props={work_orders_props(assigns)}
  banner={assigns[:banner]}
  current_user={@current_user}
/>
